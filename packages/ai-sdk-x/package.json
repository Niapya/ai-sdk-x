{
	"bugs": {
		"url": "https://github.com/niapya/ai-sdk-x/issues"
	},
	"dependencies": {
		"diff": "^9.0.0",
		"just-bash": "^3.0.1",
		"just-git": "^1.7.1",
		"yaml": "^2",
		"zod": "^4"
	},
	"scripts": {
		"build": "bunup src/index.ts --format esm,cjs --out-dir dist --dts --exports",
		"dev": "bun run build --watch",
		"prepublishOnly": "bun run build",
		"release:patch": "npm version patch --no-workspaces-update",
		"release:minor": "npm version minor --no-workspaces-update",
		"release:major": "npm version major --no-workspaces-update"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"homepage": "https://niapya.github.io/ai-sdk-x",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"name": "ai-sdk-x",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"directory": "packages/ai-sdk-x",
		"type": "git",
		"url": "git+https://github.com/Niapya/ai-sdk-x.git"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "1.1.0",
	"optionalDependencies": {
		"ai": "^6"
	}
}
